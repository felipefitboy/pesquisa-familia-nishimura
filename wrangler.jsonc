{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pesquisa-familia-nishimura",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pesquisa-familia-nishimura-db",
      "database_id": "fefb472c-ded3-47fa-90b8-3062b4c016c0"
    }
  ]
}
